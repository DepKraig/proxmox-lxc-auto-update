# /etc/msmtprc
# System-wide msmtp config so the 'mail'/'sendmail' commands relay through Gmail.
#
# INSTALL:
#   1. cp msmtprc.example /etc/msmtprc
#   2. Replace YOUR_EMAIL@gmail.com and REPLACE_WITH_APP_PASSWORD below
#      (App Password: https://myaccount.google.com/apppasswords - requires
#      2-Step Verification enabled on the Google account first)
#   3. chown root:root /etc/msmtprc && chmod 600 /etc/msmtprc
#   4. Test:  echo "test body" | mail -s "Proxmox test" YOUR_EMAIL@gmail.com
#   5. Check /var/log/msmtp.log if it doesn't arrive
#
# Using a non-Gmail provider instead? Just change host/port/from/user below
# to match your provider's SMTP settings.

defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        /var/log/msmtp.log

account        gmail
host           smtp.gmail.com
port           587
from           YOUR_EMAIL@gmail.com
user           YOUR_EMAIL@gmail.com
password       REPLACE_WITH_APP_PASSWORD

account default : gmail
